export default function App() {
  // Auth state (FR-01)
  const [isLoggedIn, setIsLoggedIn] = useState(true);
  const [currentUser, setCurrentUser] = useState({
    id: 'USR-8821',
    name: '김패스',
    phone: '010-9876-5432',
    email: 'user@passnow.kr'
  });
  const [authMode, setAuthMode] = useState('login'); // 'login' | 'signup' | 'find'

  // Navigation tab state (FR-08): 'home', 'register', 'history', 'mypage'
  const [activeTab, setActiveTab] = useState('home');

  // Barrier-Free Accessibility States (FR-06, FR-09)
  const [highContrast, setHighContrast] = useState(false);
  const [largeText, setLargeText] = useState(false);
  const [ttsEnabled, setTtsEnabled] = useState(true);
  const [vibrationEnabled, setVibrationEnabled] = useState(true);

  // Stores and History
  const [stores] = useState(INITIAL_STORES);
  const [historyList, setHistoryList] = useState(INITIAL_HISTORY);

  /* Active Waiting Ticket State Machine (FR-02, FR-05, Section 6 Rules)
     Status transitions: 
     'REGISTERED' (등록됨) -> 'IMMINENT' (호출 임박) -> 'CALLED' (호출됨) 
     -> 'COMPLETED' (입장 완료) / 'CANCELLED' (사용자 취소) / 'AUTO_CANCELLED' (자동 취소)
  */
  const [activeTicket, setActiveTicket] = useState({
    ticketId: 'PN-2026-88',
    storeId: 'STORE-101',
    storeName: '맛있는 녀석들 삼겹살 본점',
    myNumber: 38,
    currentNumber: 32, // 6 teams ahead
    partySize: 2,
    registeredAt: '18:15',
    lastUpdatedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }),
    estimatedMinutes: 18,
    status: 'REGISTERED', // 'REGISTERED' | 'IMMINENT' | 'CALLED' | 'COMPLETED' | 'CANCELLED' | 'AUTO_CANCELLED'
    callCountDown: 30 // 30-second response window when called
  });

  // Push Toast Notification state
  const [toastMessage, setToastMessage] = useState(null);

  const speakText = (text) => {
    if (!ttsEnabled) return;
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'ko-KR';
      utterance.rate = 1.0;
      window.speechSynthesis.speak(utterance);
    }
  };

  const triggerVibration = (pattern = [200, 100, 200, 100, 300]) => {
    if (!vibrationEnabled) return;
    if (navigator.vibrate) {
      navigator.vibrate(pattern);
    }
  };

  const showToast = (msg, speak = true) => {
    setToastMessage(msg);
    triggerVibration([150, 80, 150]);
    if (speak) speakText(msg);
    setTimeout(() => {
      setToastMessage(null);
    }, 4500);
  };

  useEffect(() => {
    if (!activeTicket) return;

    // Handle Active CALLED countdown (Section 6: Auto Cancel on timeout)
    let timer = null;
    if (activeTicket.status === 'CALLED') {
      if (activeTicket.callCountDown > 0) {
        timer = setInterval(() => {
          setActiveTicket((prev) => {
            if (!prev || prev.status !== 'CALLED') return prev;
            if (prev.callCountDown <= 1) {
              // Trigger Auto Cancellation
              const autoCancelledItem = {
                id: 'HIST-' + Date.now(),
                storeName: prev.storeName,
                date: new Date().toISOString().split('T')[0],
                time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
                partySize: prev.partySize,
                waitingNumber: prev.myNumber,
                totalWaitTime: '미응답 초과',
                status: '자동 취소됨'
              };
              setHistoryList((h) => [autoCancelledItem, ...h]);
              showToast(`⚠️ [자동 취소] ${prev.storeName} 응답 시간(30초)이 경과하여 대기가 자동 취소되었습니다.`);
              return null; // Active ticket cleared
            }
            return { ...prev, callCountDown: prev.callCountDown - 1 };
          });
        }, 1000);
      }
    }

    return () => {
      if (timer) clearInterval(timer);
    };
  }, [activeTicket]);

  /* Helper action to simulate advancing the queue */
  const simulateAdvanceQueue = () => {
    if (!activeTicket) {
      showToast("현재 대기 중인 매장이 없습니다.", false);
      return;
    }

    if (activeTicket.status === 'CALLED') {
      showToast("이미 호출 완료 상태입니다. 입장을 완료하거나 취소하세요.", false);
      return;
    }

    const nextCurr = activeTicket.currentNumber + 1;
    const teamsLeft = activeTicket.myNumber - nextCurr;
    const updatedTime = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

    if (teamsLeft <= 0) {
      // Called Status Trigger
      setActiveTicket((prev) => ({
        ...prev,
        currentNumber: prev.myNumber,
        status: 'CALLED',
        callCountDown: 30,
        estimatedMinutes: 0,
        lastUpdatedAt: updatedTime
      }));
      showToast(`🔔 [PASS NOW] ${activeTicket.storeName} 고객님의 순서입니다! 30초 내에 매장으로 입장해 주세요.`);
    } else if (teamsLeft <= 2) {
      // Imminent Status Trigger
      setActiveTicket((prev) => ({
        ...prev,
        currentNumber: nextCurr,
        status: 'IMMINENT',
        estimatedMinutes: Math.max(2, teamsLeft * 3),
        lastUpdatedAt: updatedTime
      }));
      showToast(`⚠️ [호출 임박] 앞에 ${teamsLeft}팀 남았습니다! 매장 근처로 이동해 주세요.`);
    } else {
      setActiveTicket((prev) => ({
        ...prev,
        currentNumber: nextCurr,
        status: 'REGISTERED',
        estimatedMinutes: Math.max(2, teamsLeft * 3),
        lastUpdatedAt: updatedTime
      }));
      showToast(`대기 순번 갱신: 내 앞 ${teamsLeft}팀 남음 (${updatedTime})`, false);
    }
  };

  /* Helper to complete seating */
  const completeAdmission = () => {
    if (!activeTicket) return;
    const completedItem = {
      id: 'HIST-' + Date.now(),
      storeName: activeTicket.storeName,
      date: new Date().toISOString().split('T')[0],
      time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      partySize: activeTicket.partySize,
      waitingNumber: activeTicket.myNumber,
      totalWaitTime: '약 ' + (activeTicket.myNumber * 2) + '분',
      status: '입장 완료'
    };
    setHistoryList((h) => [completedItem, ...h]);
    setActiveTicket(null);
    showToast("🎉 입장이 완료되었습니다! 맛있는 시간 되세요.");
  };

  /* Helper to manually cancel waiting */
  const cancelWaiting = () => {
    if (!activeTicket) return;
    if (window.confirm("정말 대기를 취소하시겠습니까?")) {
      const cancelledItem = {
        id: 'HIST-' + Date.now(),
        storeName: activeTicket.storeName,
        date: new Date().toISOString().split('T')[0],
        time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        partySize: activeTicket.partySize,
        waitingNumber: activeTicket.myNumber,
        totalWaitTime: '사용자 취소',
        status: '취소됨'
      };
      setHistoryList((h) => [cancelledItem, ...h]);
      setActiveTicket(null);
      showToast("대기 신청이 취소되었습니다.");
    }
  };

  /* Helper to snooze/postpone waiting (push back 3 teams) */
  const snoozeWaiting = () => {
    if (!activeTicket) return;
    const newMyNum = activeTicket.myNumber + 3;
    const teamsLeft = newMyNum - activeTicket.currentNumber;
    const updatedTime = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

    setActiveTicket((prev) => ({
      ...prev,
      myNumber: newMyNum,
      status: 'REGISTERED',
      estimatedMinutes: teamsLeft * 4,
      lastUpdatedAt: updatedTime
    }));
    showToast(`대기 순번이 3팀 뒤로 미뤄졌습니다. 새로운 번호: No.${newMyNum}`);
  };

  if (!isLoggedIn) {
    return (
      <div className={`min-h-screen max-w-md mx-auto bg-slate-950 text-white flex flex-col justify-between p-6 ${highContrast ? 'contrast-150 bg-black' : ''} ${largeText ? 'text-lg' : 'text-base'}`}>
        <div className="pt-10 text-center">
          <div className="inline-flex items-center justify-center p-4 bg-gradient-to-tr from-indigo-600 to-purple-600 rounded-3xl shadow-xl shadow-indigo-600/30 mb-4">
            <Zap className="w-10 h-10 text-white fill-white" />
          </div>
          <h1 className="text-3xl font-extrabold tracking-tight bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent">
            PASS NOW
          </h1>
          <p className="text-slate-400 mt-2 text-xs">기다림의 미학을 경험으로 바꾸다</p>
        </div>

        {authMode === 'login' && (
          <div className="space-y-4 my-auto">
            <div>
              <label className="block text-xs text-slate-400 mb-1 font-semibold">아이디 (이메일)</label>
              <input 
                type="text" 
                defaultValue="user@passnow.kr"
                className="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-indigo-500 transition-all text-sm"
              />
            </div>
            <div>
              <label className="block text-xs text-slate-400 mb-1 font-semibold">비밀번호</label>
              <input 
                type="password" 
                defaultValue="123456"
                className="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-indigo-500 transition-all text-sm"
              />
            </div>

            <div className="flex justify-between items-center text-xs text-slate-400 pt-1">
              <button onClick={() => setAuthMode('find')} className="hover:underline">아이디/비밀번호 찾기</button>
              <button onClick={() => setAuthMode('signup')} className="text-indigo-400 font-bold hover:underline">회원가입</button>
            </div>

            <button 
              onClick={() => {
                setIsLoggedIn(true);
                speakText("패스나우에 오신 것을 환영합니다.");
              }} 
              className="w-full bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-bold py-4 rounded-xl shadow-lg shadow-indigo-600/30 transition-all active:scale-98 mt-4 flex items-center justify-center gap-2"
            >
              로그인하기
              <ChevronRight className="w-5 h-5" />
            </button>
          </div>
        )}

        {authMode === 'signup' && (
          <div className="space-y-4 my-auto">
            <h2 className="text-xl font-bold text-slate-100 mb-2">신규 회원가입</h2>
            <div>
              <label className="block text-xs text-slate-400 mb-1">이름</label>
              <input type="text" placeholder="홍길동" className="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm" />
            </div>
            <div>
              <label className="block text-xs text-slate-400 mb-1">휴대폰 번호</label>
              <input type="tel" placeholder="010-0000-0000" className="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm" />
            </div>
            <div>
              <label className="block text-xs text-slate-400 mb-1">비밀번호</label>
              <input type="password" placeholder="8자리 이상 입력" className="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm" />
            </div>
            <button 
              onClick={() => {
                setAuthMode('login');
                showToast('회원가입 완료! 로그인해 주세요.', false);
              }}
              className="w-full bg-indigo-600 font-bold py-3.5 rounded-xl text-white mt-2"
            >
              가입완료
            </button>
            <button onClick={() => setAuthMode('login')} className="w-full text-xs text-slate-400 py-2">
              이전으로 돌아가기
            </button>
          </div>
        )}

        {authMode === 'find' && (
          <div className="space-y-4 my-auto">
            <h2 className="text-xl font-bold text-slate-100 mb-2">계정 정보 찾기</h2>
            <p className="text-xs text-slate-400">등록된 휴대폰 번호로 인증 번호를 수신합니다.</p>
            <div>
              <label className="block text-xs text-slate-400 mb-1">휴대폰 번호</label>
              <input type="tel" placeholder="010-0000-0000" className="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm" />
            </div>
            <button 
              onClick={() => {
                setAuthMode('login');
                showToast('인증번호가 발송되었습니다.');
              }}
              className="w-full bg-indigo-600 font-bold py-3.5 rounded-xl text-white"
            >
              인증번호 받기
            </button>
            <button onClick={() => setAuthMode('login')} className="w-full text-xs text-slate-400 py-2">
              로그인 화면으로
            </button>
          </div>
        )}

        <p className="text-center text-xs text-slate-600">© 2026 PASS NOW Inc. All rights reserved.</p>
      </div>
    );
  }

  return (
    <div className={`min-h-screen max-w-md mx-auto bg-slate-950 text-slate-100 flex flex-col justify-between relative shadow-2xl overflow-x-hidden border-x border-slate-800/50 ${
      highContrast ? 'contrast-150 saturate-200 bg-black text-white' : ''
    } ${largeText ? 'text-lg leading-relaxed' : 'text-sm'}`}>

      {/* Real-time Toast Push Notification Popup Banner */}
      {toastMessage && (
        <div className="fixed top-4 left-1/2 -translate-x-1/2 w-11/12 max-w-sm z-50 animate-bounce">
          <div className="bg-gradient-to-r from-indigo-600 via-purple-600 to-amber-500 text-white p-4 rounded-2xl shadow-2xl flex items-start gap-3 border border-indigo-300/40">
            <Bell className="w-6 h-6 flex-shrink-0 animate-pulse mt-0.5" />
            <div className="flex-1">
              <p className="font-bold text-[10px] uppercase tracking-wider text-indigo-100">PASS NOW 실시간 푸시 알림</p>
              <p className="font-semibold text-xs mt-0.5 leading-snug">{toastMessage}</p>
            </div>
            <button onClick={() => setToastMessage(null)} className="text-indigo-200 hover:text-white">
              <X className="w-4 h-4" />
            </button>
          </div>
        </div>
      )}

      {/* App Header Bar */}
      <header className="sticky top-0 z-40 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 px-4 py-3 flex items-center justify-between">
        <div className="flex items-center gap-2">
          <div className="w-8 h-8 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl flex items-center justify-center font-black text-white text-base shadow-lg">
            P
          </div>
          <span className="font-extrabold text-base tracking-tight bg-gradient-to-r from-indigo-400 to-purple-300 bg-clip-text text-transparent">
            PASS NOW
          </span>
        </div>

        {/* Global Quick Barrier-Free Controls (FR-06) */}
        <div className="flex items-center gap-1 bg-slate-800/80 p-1 rounded-xl border border-slate-700">
          <button 
            onClick={() => {
              const next = !ttsEnabled;
              setTtsEnabled(next);
              if (next) speakText("음성 안내 모드가 켜졌습니다.");
            }} 
            title="음성 안내 (TTS)"
            className={`p-1.5 rounded-lg transition-all ${ttsEnabled ? 'bg-indigo-600 text-white' : 'text-slate-400 hover:text-white'}`}
          >
            {ttsEnabled ? <Volume2 className="w-4 h-4" /> : <VolumeX className="w-4 h-4" />}
          </button>

          <button 
            onClick={() => {
              const next = !highContrast;
              setHighContrast(next);
              if (ttsEnabled) speakText(next ? "고대비 모드 활성화" : "일반 모드");
            }} 
            title="고대비 모드"
            className={`p-1.5 rounded-lg transition-all ${highContrast ? 'bg-yellow-400 text-slate-950 font-bold' : 'text-slate-400 hover:text-white'}`}
          >
            <Eye className="w-4 h-4" />
          </button>

          <button 
            onClick={() => setLargeText(!largeText)} 
            title="글씨 확대 모드"
            className={`px-2 py-0.5 rounded-lg text-xs font-bold transition-all ${largeText ? 'bg-purple-600 text-white' : 'text-slate-400 hover:text-white'}`}
          >
            가+
          </button>
        </div>
      </header>

      {/* Main Content Render Area */}
      <main className="flex-1 pb-24 pt-3 px-4 overflow-y-auto space-y-4">
        
        {/* Simulation Developer Control Box */}
        <div className="bg-slate-900/80 border border-indigo-900/50 rounded-2xl p-3 flex items-center justify-between">
          <div className="flex items-center gap-2 text-xs text-slate-300">
            <PlayCircle className="w-4 h-4 text-indigo-400" />
            <span className="font-semibold text-[11px]">시뮬레이터: 대기열 진행 테스트</span>
          </div>
          <button 
            onClick={simulateAdvanceQueue}
            className="bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-1 rounded-lg text-xs font-bold flex items-center gap-1 shadow transition-all active:scale-95"
          >
            1팀 줄이기 <SkipForward className="w-3 h-3" />
          </button>
        </div>

        {/* TAB 1: MAIN WAITING STATUS DASHBOARD (FR-02, FR-04, FR-05) */}
        {activeTab === 'home' && (
          <div className="space-y-4 animate-fade-in">

            {/* Active Ticket Display */}
            {activeTicket ? (
              <section className={`border-2 rounded-3xl p-5 shadow-2xl relative overflow-hidden transition-all ${
                activeTicket.status === 'CALLED' 
                  ? 'bg-gradient-to-br from-amber-950 via-slate-900 to-red-950 border-amber-500 animate-pulse'
                  : activeTicket.status === 'IMMINENT'
                  ? 'bg-gradient-to-br from-indigo-950 via-slate-900 to-purple-950 border-indigo-400'
                  : 'bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-950 border-slate-800'
              }`}>
                {/* Status Badge Header */}
                <div className="flex items-center justify-between mb-2">
                  <div className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                    <span className="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                    {activeTicket.status === 'CALLED' ? '🔔 지금 입장해 주세요!' : activeTicket.status === 'IMMINENT' ? '⚠️ 입장 임박' : '실시간 대기 중'}
                  </div>
                  <span className="text-[10px] text-slate-400 flex items-center gap-1">
                    <RefreshCw className="w-3 h-3" /> 마지막 갱신: {activeTicket.lastUpdatedAt}
                  </span>
                </div>

