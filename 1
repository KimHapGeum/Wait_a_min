function RegisterForm({ stores, activeTicket, onSubmitSuccess, speakText, showToast, setActiveTab }) {
  const [selectedStoreId, setSelectedStoreId] = useState(stores[0].id);
  const [phone, setPhone] = useState('010-9876-5432');
  const [partySize, setPartySize] = useState(2);

  const handleSubmit = (e) => {
    e.preventDefault();

    const selectedStore = stores.find(s => s.id === selectedStoreId);

    if (activeTicket && activeTicket.storeId === selectedStore.id) {
      showToast(`⚠️ 이미 ${selectedStore.name}에 대기 등록되어 있습니다.`);
      setActiveTab('home');
      return;
    }

    const mockTicket = {
      ticketId: 'PN-' + Math.floor(1000 + Math.random() * 9000),
      storeId: selectedStore.id,
      storeName: selectedStore.name,
      myNumber: selectedStore.currentTotalWaiting + 14,
      currentNumber: selectedStore.currentTotalWaiting + 6,
      partySize: partySize,
      registeredAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      lastUpdatedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }),
      estimatedMinutes: selectedStore.avgWaitPerTeam * 8,
      status: 'REGISTERED',
      callCountDown: 30
    };

    speakText(`${selectedStore.name} 대기 등록 완료. 인원 ${partySize}명.`);
    onSubmitSuccess(mockTicket);
  };

  return (
    <form onSubmit={handleSubmit} className="bg-white border border-sky-100 rounded-3xl p-5 space-y-4 shadow-sm">
      <h3 className="font-bold text-sm text-slate-800">매장 선택 및 수기 대기 등록</h3>

      <div>
        <label className="block text-xs text-slate-500 mb-1">매장 선택</label>
        <select 
          value={selectedStoreId} 
          onChange={(e) => setSelectedStoreId(e.target.value)}
          className="w-full bg-sky-50/50 border border-sky-200 rounded-xl p-3 text-xs text-slate-800 focus:outline-none focus:border-sky-500"
        >
          {stores.map((s) => (
            <option key={s.id} value={s.id}>
              {s.name} (현재 대기 {s.currentTotalWaiting}팀)
            </option>
          ))}
        </select>
      </div>

      <div>
        <label className="block text-xs text-slate-500 mb-1">알림 수신 휴대폰 번호 (번호입력란)</label>
        <input 
          type="tel" 
          value={phone}
          onChange={(e) => setPhone(e.target.value)}
          className="w-full bg-sky-50/50 border border-sky-200 rounded-xl p-3 text-xs text-slate-800"
          required 
        />
      </div>

      <div>
        <label className="block text-xs text-slate-500 mb-1">방문 인원수</label>
        <div className="flex items-center gap-3 bg-sky-50/50 p-2 rounded-xl border border-sky-200 w-fit">
          <button 
            type="button" 
            onClick={() => setPartySize(Math.max(1, partySize - 1))}
            className="w-8 h-8 bg-white rounded-lg flex items-center justify-center font-bold text-slate-700 hover:bg-sky-100 border border-sky-200 shadow-sm"
          >
            <Minus className="w-4 h-4" />
          </button>
          <span className="font-bold text-slate-800 px-2 text-sm">{partySize} 명</span>
          <button 
            type="button" 
            onClick={() => setPartySize(partySize + 1)}
            className="w-8 h-8 bg-white rounded-lg flex items-center justify-center font-bold text-slate-700 hover:bg-sky-100 border border-sky-200 shadow-sm"
          >
            <Plus className="w-4 h-4" />
          </button>
        </div>
      </div>

      <button 
        type="submit"
        className="w-full bg-gradient-to-r from-sky-400 to-blue-600 hover:from-sky-500 hover:to-blue-700 font-bold py-3.5 rounded-xl text-white text-xs shadow-lg shadow-sky-200 transition-all"
      >
        대기 번호표 즉시 발급받기
      </button>
    </form>
  );
}
