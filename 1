              setHistoryList((h) => [autoCancelledItem, ...h]);
              showToast(`⚠️ [자동 취소] ${prev.storeName} 응답 시간(30초)이 경과하여 대기가 자동 취소되었습니다.`);
              return null;
            }
            return { ...prev, callCountDown: prev.callCountDown - 1 };
          });
        }, 1000);
      }
    }

    return () => {
      if (timer) clearInterval(timer);
    };
  }, [activeTicket]);

  const simulateAdvanceQueue = () => {
    unlockAudio();
    if (!activeTicket) {
      showToast("현재 대기 중인 매장이 없습니다.", false);
      return;
    }

    if (activeTicket.status === 'CALLED') {
      showToast("이미 호출 완료 상태입니다. 입장을 완료하거나 취소하세요.", false);
      return;
    }

    const nextCurr = activeTicket.currentNumber + 1;
    const teamsLeft = activeTicket.myNumber - nextCurr;
    const updatedTime = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

    if (teamsLeft <= 0) {
      setActiveTicket((prev) => ({
        ...prev,
        currentNumber: prev.myNumber,
        status: 'CALLED',
        callCountDown: 30,
        estimatedMinutes: 0,
        lastUpdatedAt: updatedTime
      }));
      showToast(`🔔 [PASS NOW] ${activeTicket.storeName} 고객님의 순서입니다! 30초 내에 매장으로 입장해 주세요.`);
    } else if (teamsLeft <= 2) {
      setActiveTicket((prev) => ({
        ...prev,
        currentNumber: nextCurr,
        status: 'IMMINENT',
        estimatedMinutes: Math.max(2, teamsLeft * 3),
        lastUpdatedAt: updatedTime
      }));
      showToast(`⚠️ [호출 임박] 앞에 ${teamsLeft}팀 남았습니다! 매장 근처로 이동해 주세요.`);
    } else {
      setActiveTicket((prev) => ({
        ...prev,
        currentNumber: nextCurr,
        status: 'REGISTERED',
        estimatedMinutes: Math.max(2, teamsLeft * 3),
        lastUpdatedAt: updatedTime
      }));
      showToast(`대기 순번 갱신: 내 앞 ${teamsLeft}팀 남음 (${updatedTime})`, false);
    }
  };

  const completeAdmission = () => {
    if (!activeTicket) return;
    const completedItem = {
      id: 'HIST-' + Date.now(),
      storeName: activeTicket.storeName,
      date: new Date().toISOString().split('T')[0],
      time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
