function RegisterForm({ stores, activeTicket, onSubmitSuccess, speakText, showToast, setActiveTab }) {
  const [selectedStoreId, setSelectedStoreId] = useState(stores[0].id);
  const [phone, setPhone] = useState('010-9876-5432');
  const [partySize, setPartySize] = useState(2);

  const handleSubmit = (e) => {
    e.preventDefault();

    const selectedStore = stores.find(s => s.id === selectedStoreId);

    // Section 6 Check: Prevent Duplicate Active Waiting
    if (activeTicket && activeTicket.storeId === selectedStore.id) {
      showToast(`⚠️ 이미 ${selectedStore.name}에 대기 등록되어 있습니다.`);
      setActiveTab('home');
      return;
    }

    const mockTicket = {
      ticketId: 'PN-' + Math.floor(1000 + Math.random() * 9000),
      storeId: selectedStore.id,
      storeName: selectedStore.name,
      myNumber: selectedStore.currentTotalWaiting + 14,
      currentNumber: selectedStore.currentTotalWaiting + 6,
      partySize: partySize,
      registeredAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      lastUpdatedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }),
      estimatedMinutes: selectedStore.avgWaitPerTeam * 8,
      status: 'REGISTERED',
      callCountDown: 30
    };

    speakText(`${selectedStore.name} 대기 등록 완료. 인원 ${partySize}명.`);
    onSubmitSuccess(mockTicket);
  };

  return (
    <form onSubmit={handleSubmit} className="bg-slate-900 border border-slate-800 rounded-3xl p-5 space-y-4">
      <h3 className="font-bold text-sm text-slate-200">매장 선택 및 수기 대기 등록</h3>

      <div>
        <label className="block text-xs text-slate-400 mb-1">매장 선택</label>
        <select 
          value={selectedStoreId} 
          onChange={(e) => setSelectedStoreId(e.target.value)}
          className="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-indigo-500"
        >
          {stores.map((s) => (
            <option key={s.id} value={s.id}>
              {s.name} (현재 대기 {s.currentTotalWaiting}팀)
            </option>
          ))}
        </select>
      </div>

      <div>
        <label className="block text-xs text-slate-400 mb-1">알림 수신 휴대폰 번호</label>
        <input 
          type="tel" 
          value={phone}
          onChange={(e) => setPhone(e.target.value)}
          className="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-xs text-white"
          required 
        />
      </div>

      <div>
        <label className="block text-xs text-slate-400 mb-1">방문 인원수</label>
        <div className="flex items-center gap-3 bg-slate-800 p-2 rounded-xl border border-slate-700 w-fit">
          <button 
            type="button" 
            onClick={() => setPartySize(Math.max(1, partySize - 1))}
            className="w-8 h-8 bg-slate-700 rounded-lg flex items-center justify-center font-bold text-white hover:bg-slate-600"
          >
            <Minus className="w-4 h-4" />
          </button>
          <span className="font-bold text-white px-2 text-sm">{partySize} 명</span>
          <button 
            type="button" 
            onClick={() => setPartySize(partySize + 1)}
            className="w-8 h-8 bg-slate-700 rounded-lg flex items-center justify-center font-bold text-white hover:bg-slate-600"
          >
            <Plus className="w-4 h-4" />
          </button>
        </div>
      </div>

      <button 
        type="submit"
        className="w-full bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 font-bold py-3.5 rounded-xl text-white text-xs shadow-lg shadow-indigo-600/30 transition-all"
      >
        대기 번호표 즉시 발급받기
      </button>
    </form>
  );
}
