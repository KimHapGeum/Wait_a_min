            <button 
              onClick={() => {
                setAuthMode('login');
                showToast('회원가입 완료! 로그인해 주세요.', false);
              }}
              className="w-full bg-sky-500 hover:bg-sky-600 font-bold py-3 rounded-xl text-white mt-1 text-sm shadow-md shadow-sky-100"
